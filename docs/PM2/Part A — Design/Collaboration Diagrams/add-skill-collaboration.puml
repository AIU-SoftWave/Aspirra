@startuml
allowmixing
title Collaboration Diagram — Add Skill
left to right direction
skinparam shadowing false
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #555555
}

actor "Student" as Student
object "<u>controller : SkillsController</u>" as Controller {
  skillService = service
}
object "<u>request : AddSkillRequest</u>" as Request {
  name = "SQL"
  type = "Technical"
  level = 3
}
object "<u>service : SkillService</u>" as Service {
  repository = repository
}
object "<u>repository : ISkillRepository</u> «mock»" as Repository
object "<u>sql : Skill</u>" as Skill {
  name = "SQL"
  status = New -> Active
}

Student -- Controller : 1: POST /api/skills →\n1.7: 201 Created ←
Controller -- Request
Controller -- Service : 1.1: AddSkillAsync("23101371", request) →\n1.6: Ok(sql) ←
Service -- Repository : 1.2: GetByNameAsync("23101371", "SQL") →\n1.2.1: null ←\n1.4 [no duplicate]: AddAsync(sql) →\n1.5 [no duplicate]: SaveChangesAsync() →
Service -- Skill : 1.3 [no duplicate]: Activate() →

note bottom of Repository
  Moq Verify: GetByNameAsync once,
  AddAsync once, SaveChangesAsync once.
end note

@enduml
