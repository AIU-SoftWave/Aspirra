@startuml
title Sequence Diagram — Complete Goal

participant "Student" as Student
participant "GoalsController" as Controller
participant "GoalService" as Service
participant "IGoalRepository" as Repository
participant "Goal" as Goal

Student -> Controller : 1: POST /api/goals/{goalId}/complete
activate Controller
Controller -> Service : 1.1: CompleteGoalAsync(goalId)
activate Service
Service -> Repository : 1.2: GetByIdAsync(goalId)
activate Repository
Repository --> Service : 1.2.1: goal
deactivate Repository

alt goal is null
  Service --> Controller : throw GoalNotFoundException
  Controller --> Student : 404 NOT_FOUND
else goal.Status == Archived
  Service -> Goal : 1.3: Complete()
  Goal --> Service : throw GoalValidationException(INVALID_TRANSITION)
  Service --> Controller : 400 INVALID_TRANSITION (no UpdateAsync)
else Active or Completed
  Service -> Goal : 1.3: Complete()
  activate Goal
  Goal --> Service : status = Completed; CompletionDate ??= today
  deactivate Goal
  Service -> Service : UpdatedAt = UtcNow
  Service -> Repository : 1.4: UpdateAsync(goal)
  activate Repository
  Repository --> Service : saved
  deactivate Repository
  Service --> Controller : goal
  deactivate Service
  Controller --> Student : 200 OK { goal }
  deactivate Controller
end

note over Service
  Invalid transitions are rejected before UpdateAsync.
end note

@enduml
