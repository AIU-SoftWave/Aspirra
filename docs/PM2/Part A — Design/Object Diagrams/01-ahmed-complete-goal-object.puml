@startuml
title Object Diagram — Complete Goal (Active -> Completed)

object "student : Student" as Student
object "controller : GoalsController" as Controller
object "service : GoalService" as Service
object "repository : IGoalRepository <<mock>>" as Repository
object "goal : Goal" as Goal

Student --> Controller : POST /api/goals/goal-1001/complete
Controller --> Service : CompleteGoalAsync("goal-1001")
Service --> Repository : GetByIdAsync("goal-1001")
Repository --> Service : goal
Service --> Goal : Complete()
Goal --> Service : status = Completed; completionDate = 2026-11-24
Service --> Repository : UpdateAsync(goal)
Repository --> Service : saved (verified: UpdateAsync once)
Service --> Controller : goal
Controller --> Student : 200 OK

note right of Goal
  goalId = "goal-1001"
  studentId = "23101359"
  title = "Reach a 3.5 GPA"
  status = Active -> Completed
  targetDate = 2026-12-20
  priority = "High"
  completionDate = 2026-11-24
end note

note bottom of Repository
  Mock of IGoalRepository (Moq).
end note

@enduml
