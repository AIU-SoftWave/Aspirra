@startuml
title Object Diagram — Add Skill (snapshot after the skill is saved)
left to right direction
skinparam shadowing false
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #555555
}

object "<u>controller : SkillsController</u>" as Controller {
  skillService = service
}
object "<u>request : AddSkillRequest</u>" as Request {
  studentId = "23101371"
  name = "SQL"
  type = "Technical"
  level = 3
}
object "<u>service : SkillService</u>" as Service {
  repository = repository
}
object "<u>repository : ISkillRepository</u> «mock»" as Repository
object "<u>sql : Skill</u>" as Skill {
  skillId = "skill-2001"
  studentId = "23101371"
  name = "SQL"
  type = Technical
  level = 3
  status = Active
}

Controller -- Request : receives
Controller -- Service : uses ISkill
Service -- Repository : uses
Service -- Skill : creates
Repository "1" -- "0..*" Skill : stores

@enduml
