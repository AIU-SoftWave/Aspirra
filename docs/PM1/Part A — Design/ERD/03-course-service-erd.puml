@startuml course-service-erd
hide circle
skinparam linetype ortho

title ERD - Course Service (FR-03) | Owner: Ahmed Mohamed Ahmed\nNote: Shared DB instance, each service owns its own schema/tables. No service reads another service's database directly.

entity "Course" as Course {
  * courseId : VARCHAR(50) <<PK>>
  --
  studentId : VARCHAR(50)
  name : VARCHAR(150)
  code : VARCHAR(50)
  instructor : VARCHAR(100)
  semester : VARCHAR(50)
  credits : INT
  weeklyWorkloadHours : INT
  createdAt : DATETIME
  updatedAt : DATETIME
}

entity "CourseEnrollment" as CourseEnrollment {
  * enrollmentId : VARCHAR(50) <<PK>>
  --
  courseId : VARCHAR(50) <<FK to Course>>
  studentId : VARCHAR(50)
  enrollmentDate : DATE
  status : VARCHAR(20)
}

Course ||--o{ CourseEnrollment : "has enrollments"
' Note: studentId references are logical only (no cross-service FK)
@enduml
