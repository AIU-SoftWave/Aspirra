@startuml goal-planner-service-erd
hide circle
skinparam linetype ortho

title ERD - Goal Planner Service (FR-05) | Owner: Yomna Mohamed Fekry\nSchema: goal_planner | Note: Shared DB instance, each service owns its own schema/tables. No service reads another service's database directly.

entity "PlanDraft" as PlanDraft {
  * draftId : VARCHAR(64) <<PK>>
  --
  studentId : VARCHAR(64)
  goalId : VARCHAR(64) <<NULL>>
  goalText : TEXT
  status : VARCHAR(20)
  createdAt : TIMESTAMPTZ
  updatedAt : TIMESTAMPTZ
}

entity "Milestone" as Milestone {
  * milestoneId : VARCHAR(64) <<PK>>
  --
  draftId : VARCHAR(64) <<FK to PlanDraft>>
  title : TEXT
  deadline : DATE
  orderIndex : INT
}

entity "PlanTask" as PlanTask {
  * taskId : VARCHAR(64) <<PK>>
  --
  milestoneId : VARCHAR(64) <<FK to Milestone>>
  title : TEXT
  durationHours : INT
  deadline : DATE
  dependsOnTaskId : VARCHAR(64) <<NULL, logical FK to PlanTask>>
  orderIndex : INT
}

PlanDraft ||--o{ Milestone : "contains"
Milestone ||--o{ PlanTask : "contains"
PlanTask }o--o| PlanTask : "depends on"
' Note: goalId/studentId are logical references (no cross-service FK)
@enduml
