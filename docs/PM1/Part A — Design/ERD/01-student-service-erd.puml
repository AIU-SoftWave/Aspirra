@startuml student-service-erd
hide circle
skinparam linetype ortho

title ERD - Student Service (FR-01) | Owner: Ahmed Mohamed Ahmed\nSchema: student | Note: Shared DB instance, each service owns its own schema/tables. No service reads another service's database directly.

entity "Profile" as Profile {
  * studentId : VARCHAR(50) <<PK>>
  --
  academicLevel : VARCHAR(50)
  major : VARCHAR(100)
  interests : TEXT <<semicolon-separated list>>
  skills : TEXT <<semicolon-separated list>>
  careerInterests : TEXT <<semicolon-separated list>>
  createdAt : TIMESTAMPTZ
  updatedAt : TIMESTAMPTZ
}

entity "TimeSlot" as TimeSlot {
  * timeSlotId : VARCHAR(50) <<PK>>
  --
  studentId : VARCHAR(50) <<FK to Profile>>
  dayOfWeek : VARCHAR(20)
  startTime : TIME
  endTime : TIME
}

Profile ||--o{ TimeSlot : "has availability"
@enduml
