@startuml habit-service-erd
hide circle
skinparam linetype ortho

title ERD - Habit Service (FR-13) | Owner: Mostafa Khamis Abozead\nSchema: habit | Note: Shared DB instance, each service owns its own schema/tables. No service reads another service's database directly.

entity "Habit" as Habit {
  * habitId : VARCHAR(64) <<PK>>
  --
  studentId : VARCHAR(64)
  goalId : VARCHAR(64) <<NULL>>
  name : VARCHAR(200)
  frequency : VARCHAR(20)
  goalTarget : VARCHAR(500) <<NULL>>
  reminderTime : TIME <<NULL>>
  currentStreak : INT
  isActive : BOOLEAN
  createdAt : TIMESTAMPTZ
  updatedAt : TIMESTAMPTZ
}

entity "HabitLog" as HabitLog {
  * logId : VARCHAR(64) <<PK>>
  --
  habitId : VARCHAR(64) <<FK to Habit>>
  logDate : DATE
  completed : BOOLEAN
  completedAt : TIMESTAMPTZ <<NULL>>
}

Habit ||--o{ HabitLog : "has logs"
note bottom of HabitLog
  Unique index: (habitId, logDate)
end note
' Note: goalId/studentId are logical references (no cross-service FK)
@enduml
