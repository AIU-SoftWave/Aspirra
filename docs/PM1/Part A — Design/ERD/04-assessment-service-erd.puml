@startuml assessment-service-erd
hide circle
skinparam linetype ortho

title ERD - Assessment Service (FR-04) | Owner: Ahmed Mohamed Ahmed\nSchema: assessment | Note: Shared DB instance, each service owns its own schema/tables. No service reads another service's database directly.

entity "Assignment" as Assignment {
  * assignmentId : VARCHAR(64) <<PK>>
  --
  courseId : VARCHAR(64)
  studentId : VARCHAR(64)
  title : VARCHAR(200)
  description : VARCHAR(2000)
  dueDate : DATE
  priority : VARCHAR(50)
  status : VARCHAR(20)
  createdAt : TIMESTAMPTZ
  updatedAt : TIMESTAMPTZ
}

entity "Exam" as Exam {
  * examId : VARCHAR(64) <<PK>>
  --
  courseId : VARCHAR(64)
  studentId : VARCHAR(64)
  title : VARCHAR(200)
  examDate : DATE
  examTime : TIME
  location : VARCHAR(200)
  preparationReminderDays : INT
  createdAt : TIMESTAMPTZ
  updatedAt : TIMESTAMPTZ
}

' Note: courseId/studentId are logical references (no cross-service FK)
@enduml
