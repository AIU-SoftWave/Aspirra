@startuml student-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Student Service (FR-01) | Owner: Ahmed Mohamed Ahmed

actor "Student" as student
interface "IStudentProfile" as p_istudent

component "<<container>>\nStudent Service" as studentContainer {
  portin " " as port_in
  portout " " as port_db

  component "ProfilesController\n(/api/profiles)" as ctrl
  component "StudentProfileService" as svc
  component "ProfileRepository" as repo
  component "StudentDbContext" as dbctx

  port_in -- ctrl
  ctrl -(0- svc : IStudentProfile
  svc -(0- repo : IProfileRepository
  repo --> dbctx : uses
  dbctx -- port_db
}

database "Aspirra DB\n(student schema:\nProfiles, TimeSlots)" as db <<database>>

student --( p_istudent
p_istudent -- port_in

port_db -(0- db : IStudentDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
