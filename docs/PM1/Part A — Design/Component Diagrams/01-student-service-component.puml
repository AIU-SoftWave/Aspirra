@startuml student-service-component-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Level 2: Component Diagram - Student Service (FR-01) | Owner: Ahmed Mohamed Ahmed

Container_Boundary(studentBoundary, "Student Service") {

  Component(iStudentProfile, "IStudentProfile", "Provided Interface", "createProfile, updateProfile, getProfile, getAvailability")
  Component(profilesController, "ProfilesController", "API Controller", "Exposes /api/profiles endpoints")
  Component(studentProfileService, "StudentProfileService", "Component", "Implements profile use cases and validates required fields and time slots")
  Component(iProfileRepo, "IProfileRepository", "Repository Interface", "Persistence abstraction for Profile and TimeSlot")
  Component(profileRepo, "ProfileRepository", "Repository", "EF Core implementation of IProfileRepository")
  Component(studentDb, "StudentDbContext", "EF Core DbContext", "Owns the student schema (Profiles, TimeSlots)")
  Component(domainModel, "Profile, TimeSlot", "Domain Model", "Owned entities")
}

Rel(profilesController, iStudentProfile, "Exposes")
Rel(profilesController, studentProfileService, "Calls")
Rel(studentProfileService, iProfileRepo, "Depends on")
Rel(profileRepo, iProfileRepo, "Implements")
Rel(profileRepo, studentDb, "Uses")
Rel(studentDb, domainModel, "Maps to/from")

SHOW_LEGEND()
@enduml
