@startuml skill-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Skill Service (FR-10) | Owner: Arwa Mohey Hamdy

actor "Student" as student
interface "ISkill" as p_iskill

component "<<container>>\nSkill Service" as skillContainer {
  portin " " as port_in
  portout " " as port_career
  portout " " as port_db

  component "SkillService" as svc
  component "GapAnalyzer" as analyzer
  component "SkillRepository" as repo

  port_in -- svc
  svc -(0- analyzer : IGapAnalyzer
  svc -(0- repo : ISkillRepository

  svc -- port_career
  repo -- port_db
}

component "Career Service" as careerSvc <<service>>
database "Aspirra DB\n(skill schema:\nSkills, SkillGaps)" as db <<database>>

student --( p_iskill
p_iskill -- port_in

port_career -(0- careerSvc : ICareer
port_db -(0- db : ISkillDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
