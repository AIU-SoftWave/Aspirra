@startuml adaptation-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Adaptation Service (FR-08) | Owner: Yomna Mohamed Fekry

actor "Student" as student
interface "IAdaptation" as p_iadapt

component "<<container>>\nAdaptation Service" as adaptationContainer {
  portin " " as port_in
  portout " " as port_sched
  portout " " as port_db

  component "AdaptationService" as svc
  component "RecommendationEngine" as engine
  component "AdaptationRepository" as repo

  port_in -- svc
  svc -(0- engine : IRecommendationEngine
  svc -(0- repo : IAdaptationRepository

  svc -- port_sched
  repo -- port_db
}

component "Scheduling Service" as schedulingSvc <<service>>
database "Aspirra DB\n(adaptation schema:\nRecommendations, AdaptationStates)" as db <<database>>

student --( p_iadapt
p_iadapt -- port_in

port_sched -(0- schedulingSvc : IScheduling
port_db -(0- db : IAdaptationDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
