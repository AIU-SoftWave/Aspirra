@startuml dashboard-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 28
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Dashboard Service (FR-17) | Owner: Muhammed Hany Hamdy

actor "Student" as student
interface "IDashboard" as p_idash

component "<<container>>\nDashboard Service" as dashboardContainer {
  portin " " as port_in
  portout " " as port_goal
  portout " " as port_sched
  portout " " as port_adapt
  portout " " as port_habit
  portout " " as port_analytics
  portout " " as port_career
  portout " " as port_db

  component "DashboardService" as svc
  component "DashboardAggregator" as aggregator
  component "DashboardRepository" as repo

  port_in -- svc
  svc -(0- aggregator : IDashboardAggregator
  svc -(0- repo : IDashboardRepository

  aggregator -- port_goal
  aggregator -- port_sched
  aggregator -- port_adapt
  aggregator -- port_habit
  aggregator -- port_analytics
  aggregator -- port_career
  repo -- port_db
}

component "Academic Service" as academicSvc <<service>>
component "Scheduling Service" as schedulingSvc <<service>>
component "Adaptation Service" as adaptationSvc <<service>>
component "Habit Service" as habitSvc <<service>>
component "Analytics Service" as analyticsSvc <<service>>
component "Career Service" as careerSvc <<service>>
database "Aspirra DB\n(dashboard schema:\nDashboardCache, WidgetData)" as db <<database>>

student --( p_idash
p_idash -- port_in

port_goal -(0- academicSvc : IGoal
port_sched -(0- schedulingSvc : IScheduling
port_adapt -(0- adaptationSvc : IAdaptation
port_habit -(0- habitSvc : IHabit
port_analytics -(0- analyticsSvc : IAnalytics
port_career -(0- careerSvc : ICareer
port_db -(0- db : IDashboardDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
