@startuml academic-service-component-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Level 2: Component Diagram - Academic Service (FR-02) | Owner: Ahmed Mohamed Ahmed

Container_Boundary(academicBoundary, "Academic Service") {

  Component(iGoal, "IGoal", "Provided Interface", "createGoal, updateGoal, completeGoal, archiveGoal, restoreGoal, deleteGoal, getGoal, getGoals")
  Component(goalsController, "GoalsController", "API Controller", "Exposes /api/goals endpoints")
  Component(goalService, "GoalService", "Component", "Implements the goal lifecycle and validates goal data and dates")
  Component(iGoalRepo, "IGoalRepository", "Repository Interface", "Persistence abstraction for Goal")
  Component(goalRepo, "GoalRepository", "Repository", "EF Core implementation of IGoalRepository")
  Component(academicDb, "AcademicDbContext", "EF Core DbContext", "Owns the academic schema (Goals)")
  Component(domainModel, "Goal, GoalStatus", "Domain Model", "Owned entity and enum")
}

Rel(goalsController, iGoal, "Exposes")
Rel(goalsController, goalService, "Calls")
Rel(goalService, iGoalRepo, "Depends on")
Rel(goalRepo, iGoalRepo, "Implements")
Rel(goalRepo, academicDb, "Uses")
Rel(academicDb, domainModel, "Maps to/from")

SHOW_LEGEND()
@enduml
