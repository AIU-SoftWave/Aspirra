@startuml academic-service-component-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Level 2: Component Diagram - Academic Service (FR-02) | Owner: Ahmed Mohamed Ahmed

Container_Boundary(academicBoundary, "Academic Service") {
  
  ' Provided interface
  Component(iGoal, "IGoal", "Provided Interface", "createGoal, updateGoal, completeGoal, archiveGoal, restoreGoal, deleteGoal, getGoals")
  
  ' Core components
  Component(goalService, "GoalService", "Component", "Orchestrates goal lifecycle. Applies SOLID principles.")
  Component(goalValidator, "GoalValidator", "Component", "Validates goal data and dates")
  
  ' Persistence
  Component(goalRepo, "IGoalRepository", "Repository Interface / Component", "Data access for Goal (owned)")
  
  ' Domain
  Component(domainModel, "Goal, GoalStatus", "Domain Model", "Owned entities and enums")
}

' Required interfaces to other service containers
Container_Ext(studentSvc, "Student Service", "ASP.NET Core API", "Provides IStudentProfile")

' Internal relationships
Rel(iGoal, goalService, "Delegates calls")
Rel(goalService, goalValidator, "Uses")
Rel(goalService, goalRepo, "Uses (IGoalRepository)")
Rel(goalRepo, domainModel, "Maps to/from")

' Cross-service relationships
Rel(goalService, studentSvc, "Uses IStudentProfile (required)")

SHOW_LEGEND()
@enduml
