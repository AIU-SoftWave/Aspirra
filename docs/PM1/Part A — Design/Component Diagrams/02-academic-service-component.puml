@startuml academic-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Academic Service (FR-02) | Owner: Ahmed Mohamed Ahmed

actor "Student" as student
interface "IGoal" as p_igoal

component "<<container>>\nAcademic Service" as academicContainer {
  portin " " as port_in
  portout " " as port_db

  component "GoalsController\n(/api/goals)" as ctrl
  component "GoalService" as svc
  component "GoalRepository" as repo
  component "AcademicDbContext" as dbctx

  port_in -- ctrl
  ctrl -(0- svc : IGoal
  svc -(0- repo : IGoalRepository
  repo --> dbctx : uses
  dbctx -- port_db
}

database "Aspirra DB\n(academic schema:\nGoals)" as db <<database>>

student --( p_igoal
p_igoal -- port_in

port_db -(0- db : IAcademicDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
