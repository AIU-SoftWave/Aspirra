@startuml goal-planner-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
  BackgroundColor<<external>> #F1F5F9
  BorderColor<<external>> #475569
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Goal Planner Service (FR-05) | Owner: Yomna Mohamed Fekry

actor "Student" as student
interface "IGoalPlanner" as p_igplan

component "<<container>>\nGoal Planner Service" as goalPlannerContainer {
  portin " " as port_in
  portout " " as port_goal
  portout " " as port_ai
  portout " " as port_db

  component "PlansController\n(/api/plans)" as ctrl
  component "GoalPlannerService" as svc
  component "HttpGoalClient" as goalClient
  component "MockAIProvider\n(AI Adapter)" as aiAdapter
  component "PlanDraftRepository" as repo
  component "GoalPlannerDbContext" as dbctx

  port_in -- ctrl
  ctrl -(0- svc : IGoalPlanner
  svc -(0- goalClient : IGoalClient
  svc -(0- aiAdapter : IAIProvider
  svc -(0- repo : IPlanDraftRepository
  repo --> dbctx : uses

  goalClient -- port_goal
  aiAdapter -- port_ai
  dbctx -- port_db
}

component "Academic Service" as academicSvc <<service>>
component "AI Provider\n(External LLM API)" as aiProvider <<external>>
database "Aspirra DB\n(goal_planner schema:\nPlanDrafts, Milestones, PlanTasks)" as db <<database>>

student --( p_igplan
p_igplan -- port_in

port_goal -(0- academicSvc : IGoal
port_ai -(0- aiProvider : IAIProvider
port_db -(0- db : IGoalPlannerDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
