@startuml goal-planner-service-component-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Level 2: Component Diagram - Goal Planner Service (FR-05) | Owner: Yomna Mohamed Fekry

Container_Boundary(goalPlannerBoundary, "Goal Planner Service") {
  
  ' Provided interface
  Component(iGoalPlanner, "IGoalPlanner", "Provided Interface", "generatePlan, updateDraft, approve, discard, getTasks")
  
  ' Core components
  Component(goalPlannerService, "GoalPlannerService", "Component", "Orchestrates AI-assisted goal planning. Applies SOLID principles.")
  Component(planPromptBuilder, "PlanPromptBuilder", "Component", "Builds AI prompts")
  Component(planSchemaValidator, "PlanSchemaValidator", "Component", "Validates AI response schema")
  
  ' Persistence
  Component(planDraftRepo, "IPlanDraftRepository", "Repository Interface / Component", "Data access for PlanDraft, Milestone, PlanTask (owned)")
  
  ' Domain
  Component(domainModel, "PlanDraft, Milestone, PlanTask", "Domain Model", "Owned entities")
}

' Required interfaces
Container_Ext(academicSvc, "Academic Service", "ASP.NET Core API", "Provides IGoal")
System_Ext(aiProvider, "AI Provider", "External LLM API", "Provides IAIProvider")

' Internal relationships
Rel(iGoalPlanner, goalPlannerService, "Delegates calls")
Rel(goalPlannerService, planPromptBuilder, "Uses")
Rel(goalPlannerService, planSchemaValidator, "Uses")
Rel(goalPlannerService, planDraftRepo, "Uses (IPlanDraftRepository)")
Rel(planDraftRepo, domainModel, "Maps to/from")

' Cross-service/external relationships
Rel(goalPlannerService, academicSvc, "Uses IGoal (required)")
Rel(goalPlannerService, aiProvider, "Uses IAIProvider (required)")

SHOW_LEGEND()
@enduml
