@startuml habit-service-component-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Level 2: Component Diagram - Habit Service (FR-13) | Owner: Mostafa Khamis Abozead

Container_Boundary(habitBoundary, "Habit Service") {

  Component(iHabit, "IHabit", "Provided Interface", "createHabit, completeHabit, getHabits, getStreaks, linkHabitToGoal")
  Component(habitsController, "HabitsController", "API Controller", "Exposes /api/habits endpoints")
  Component(habitService, "HabitService", "Component", "Implements habit creation, completion, streak calculation, and goal linking")
  Component(iHabitRepo, "IHabitRepository", "Repository Interface", "Persistence abstraction for Habit and HabitLog")
  Component(habitRepo, "HabitRepository", "Repository", "EF Core implementation of IHabitRepository")
  Component(habitDb, "HabitDbContext", "EF Core DbContext", "Owns the habit schema (Habits, HabitLogs)")
  Component(domainModel, "Habit, HabitLog, HabitFrequency", "Domain Model", "Owned entities and enum")
}

Rel(habitsController, iHabit, "Exposes")
Rel(habitsController, habitService, "Calls")
Rel(habitService, iHabitRepo, "Depends on")
Rel(habitRepo, iHabitRepo, "Implements")
Rel(habitRepo, habitDb, "Uses")
Rel(habitDb, domainModel, "Maps to/from")

SHOW_LEGEND()
@enduml
