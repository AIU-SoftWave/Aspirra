@startuml habit-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Habit Service (FR-13) | Owner: Mostafa Khamis Abozead

actor "Student" as student
interface "IHabit" as p_ihabit

component "<<container>>\nHabit Service" as habitContainer {
  portin " " as port_in
  portout " " as port_db

  component "HabitsController\n(/api/habits)" as ctrl
  component "HabitService" as svc
  component "HabitRepository" as repo
  component "HabitDbContext" as dbctx

  port_in -- ctrl
  ctrl -(0- svc : IHabit
  svc -(0- repo : IHabitRepository
  repo --> dbctx : uses
  dbctx -- port_db
}

database "Aspirra DB\n(habit schema:\nHabits, HabitLogs)" as db <<database>>

student --( p_ihabit
p_ihabit -- port_in

port_db -(0- db : IHabitDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
