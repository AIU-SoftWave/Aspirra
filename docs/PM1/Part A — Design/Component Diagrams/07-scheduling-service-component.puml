@startuml scheduling-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Scheduling Service (FR-07) | Owner: Yomna Mohamed Fekry

actor "Student" as student
interface "IScheduling" as p_isched

component "<<container>>\nScheduling Service" as schedulingContainer {
  portin " " as port_in
  portout " " as port_gplan
  portout " " as port_assess
  portout " " as port_student
  portout " " as port_db

  component "SchedulingService" as svc
  component "ConflictResolver" as resolver
  component "ScheduleRepository" as repo

  port_in -- svc
  svc -(0- resolver : IConflictResolver
  svc -(0- repo : IScheduleRepository

  svc -- port_gplan
  svc -- port_assess
  svc -- port_student
  repo -- port_db
}

component "Goal Planner Service" as goalPlannerSvc <<service>>
component "Assessment Service" as assessmentSvc <<service>>
component "Student Service" as studentSvc <<service>>
database "Aspirra DB\n(scheduling schema:\nSchedules, ScheduledTasks, Conflicts)" as db <<database>>

student --( p_isched
p_isched -- port_in

port_gplan -(0- goalPlannerSvc : IGoalPlanner
port_assess -(0- assessmentSvc : IAssessment
port_student -(0- studentSvc : IStudentProfile
port_db -(0- db : ISchedulingDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
