@startuml course-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Course Service (FR-03) | Owner: Ahmed Mohamed Ahmed

actor "Student" as student
interface "ICourse" as p_icourse

component "<<container>>\nCourse Service" as courseContainer {
  portin " " as port_in
  portout " " as port_assess
  portout " " as port_db

  component "CoursesController\n(/api/courses)" as ctrl
  component "CourseService" as svc
  component "CourseRepository" as repo
  component "HttpAssessmentClient" as client
  component "CourseDbContext" as dbctx

  port_in -- ctrl
  ctrl -(0- svc : ICourse
  svc -(0- repo : ICourseRepository
  svc -(0- client : IAssessmentClient
  repo --> dbctx : uses
  client -- port_assess
  dbctx -- port_db
}

component "Assessment Service" as assessSvc <<service>>
database "Aspirra DB\n(course schema:\nCourses, CourseEnrollments)" as db <<database>>

student --( p_icourse
p_icourse -- port_in

port_assess -(0- assessSvc : IAssessment
port_db -(0- db : ICourseDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
