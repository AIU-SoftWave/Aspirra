@startuml course-service-component-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Level 2: Component Diagram - Course Service (FR-03) | Owner: Ahmed Mohamed Ahmed

Container_Boundary(courseBoundary, "Course Service") {

  Component(iCourse, "ICourse", "Provided Interface", "addCourse, updateCourse, removeCourse, getCourse, getCourses, getCourseProgress")
  Component(coursesController, "CoursesController", "API Controller", "Exposes /api/courses endpoints")
  Component(courseService, "CourseService", "Component", "Implements course management and course progress")
  Component(iCourseRepo, "ICourseRepository", "Repository Interface", "Persistence abstraction for Course and CourseEnrollment")
  Component(courseRepo, "CourseRepository", "Repository", "EF Core implementation of ICourseRepository")
  Component(iAssessmentClient, "IAssessmentClient", "Required Interface", "Fetches course assignments from the Assessment Service")
  Component(httpAssessmentClient, "HttpAssessmentClient", "Client Adapter", "HTTP implementation of IAssessmentClient")
  Component(courseDb, "CourseDbContext", "EF Core DbContext", "Owns the course schema (Courses, CourseEnrollments)")
  Component(domainModel, "Course, CourseEnrollment, CourseProgress", "Domain Model", "Owned entities and read model")
}

Rel(coursesController, iCourse, "Exposes")
Rel(coursesController, courseService, "Calls")
Rel(courseService, iCourseRepo, "Depends on")
Rel(courseService, iAssessmentClient, "Depends on")
Rel(courseRepo, iCourseRepo, "Implements")
Rel(httpAssessmentClient, iAssessmentClient, "Implements")
Rel(courseRepo, courseDb, "Uses")
Rel(courseDb, domainModel, "Maps to/from")

Container_Ext(assessmentSvc, "Assessment Service", "ASP.NET Core API", "Provides IAssessment")
Rel(httpAssessmentClient, assessmentSvc, "Uses IAssessment (required)")

SHOW_LEGEND()
@enduml
