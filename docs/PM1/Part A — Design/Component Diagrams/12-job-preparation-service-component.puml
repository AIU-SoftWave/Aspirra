@startuml job-preparation-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Job Preparation Service (FR-12) | Owner: Arwa Mohey Hamdy

actor "Student" as student
interface "IJobPrep" as p_ijobprep

component "<<container>>\nJob Preparation Service" as jobPrepContainer {
  portin " " as port_in
  portout " " as port_db

  component "JobPreparationService" as svc
  component "ApplicationTracker" as tracker
  component "JobPrepRepository" as repo

  port_in -- svc
  svc -(0- tracker : IApplicationTracker
  svc -(0- repo : IJobPrepRepository
  repo -- port_db
}

database "Aspirra DB\n(job_preparation schema:\nJobApplications, InterviewPrepTasks)" as db <<database>>

student --( p_ijobprep
p_ijobprep -- port_in

port_db -(0- db : IJobPrepDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
