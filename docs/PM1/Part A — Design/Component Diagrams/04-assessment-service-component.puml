@startuml assessment-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Assessment Service (FR-04) | Owner: Ahmed Mohamed Ahmed

actor "Student" as student
interface "IAssessment" as p_iassess

component "<<container>>\nAssessment Service" as assessmentContainer {
  portin " " as port_in
  portout " " as port_db

  component "Assessment API Controllers\n(Assignments, Exams, Assessments, Courses)" as ctrl
  component "AssessmentService" as svc
  component "EfAssessmentRepository" as repo
  component "AssessmentDbContext" as dbctx

  port_in -- ctrl
  ctrl -(0- svc : IAssessment
  svc -(0- repo : IAssessmentRepository
  repo --> dbctx : uses
  dbctx -- port_db
}

database "Aspirra DB\n(assessment schema:\nAssignments, Exams)" as db <<database>>

student --( p_iassess
p_iassess -- port_in

port_db -(0- db : IAssessmentDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
