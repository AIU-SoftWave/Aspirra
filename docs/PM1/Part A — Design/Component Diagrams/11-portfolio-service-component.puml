@startuml portfolio-service-component-diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 2: Component Diagram - Portfolio Service (FR-11) | Owner: Arwa Mohey Hamdy

actor "Student" as student
interface "IPortfolio" as p_iportf

component "<<container>>\nPortfolio Service" as portfolioContainer {
  portin " " as port_in
  portout " " as port_skill
  portout " " as port_db

  component "PortfolioService" as svc
  component "PortfolioValidator" as validator
  component "PortfolioRepository" as repo

  port_in -- svc
  svc -(0- validator : IPortfolioValidator
  svc -(0- repo : IPortfolioRepository

  svc -- port_skill
  repo -- port_db
}

component "Skill Service" as skillSvc <<service>>
database "Aspirra DB\n(portfolio schema:\nProjects, PortfolioArtifacts)" as db <<database>>

student --( p_iportf
p_iportf -- port_in

port_skill -(0- skillSvc : ISkill
port_db -(0- db : IPortfolioDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Lollipop O / Socket ( | Provided / Required interface |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
endlegend
@enduml
