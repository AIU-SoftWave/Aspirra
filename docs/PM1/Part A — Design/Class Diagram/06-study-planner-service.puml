@startuml study-planner-service-class-diagram
title Level 3: Code - Class Diagram (study-planner-service) - FR-06\nOwner: Yomna Mohamed Fekry
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam nodesep 35
skinparam ranksep 55
skinparam ArrowColor #444444
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  BackgroundColor<<component>> #D5EFE0
  BorderColor<<component>> #2E8B57
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
hide empty members

legend right
  |<#D5EFE0>   | Class of a component |
  |<#FFFFFF>   | Interface / domain class |
  | Solid arrow, open head | Uses (required interface / class) |
  | Dotted arrow, hollow head | Implements (provided interface) |
  | Filled diamond | Composition |
  | Plain line | Association |
endlegend

interface IStudyPlanner <<provided>> {
  +generatePlan(studentId): StudyPlan
  +regeneratePlan(studentId): StudyPlan
  +getPlan(studentId): StudyPlan
}

class StudyPlannerService <<component>> {
  -course: ICourse
  -scheduling: IScheduling
  -aiProvider: IAIProvider
  -repository: IStudyPlanRepository
  -studyPlanPromptBuilder: StudyPlanPromptBuilder
  -studyPlanValidator: StudyPlanValidator
  --
  +generatePlan(...) / regeneratePlan(...)
  +getPlan(...)
}

IStudyPlanner <|.. StudyPlannerService
class StudyPlanPromptBuilder <<component>> {
  +build(courses, slots): String
}
StudyPlannerService --> StudyPlanPromptBuilder
class StudyPlanValidator <<component>> {
  +isValid(plan): boolean
}
StudyPlannerService --> StudyPlanValidator

interface ICourse <<required - Course service>> {
  +addCourse(studentId, data): Course
  +updateCourse(courseId, data): Course
  +removeCourse(courseId): void
  +getCourseProgress(courseId): CourseProgress
}

StudyPlannerService --> ICourse
interface IScheduling <<required - Scheduling service>> {
  +scheduleTasks(studentId): Schedule
  +getConflicts(studentId): List<Conflict>
  +suggestSlots(taskId): List<TimeSlot>
  +moveTask(taskId, slot): void
  +markDone(taskId, done): void
  +getScheduledTasks(studentId, range): List<ScheduledTask>
}

StudyPlannerService --> IScheduling
interface IAIProvider <<required - AI provider>> {
  +generate(prompt): AIResponse
}

StudyPlannerService --> IAIProvider
interface IStudyPlanRepository <<required - Database>> {
  +save(item: StudyPlan): void
  +findById(id): StudyPlan
  +findByOwner(ownerId): List<StudyPlan>
}

StudyPlannerService --> IStudyPlanRepository
class StudyPlan {
  -planId: String
  -studentId: String
  -createdAt: Date
  --
  +isValid(): boolean
}
class StudyBlock {
  -task: String
  -slot: TimeSlot
  -priority: int
}
IStudyPlanRepository --> StudyPlan
StudyPlan *-- "1..*" StudyBlock
note bottom of StudyPlannerService
SOLID applied:
S - StudyPlannerService only coordinates; StudyPlanPromptBuilder, StudyPlanValidator each do one job.
O - A rejected plan never replaces the saved one; validation is a separate class (SRP).
L - StudyPlannerService can replace any other IStudyPlanner implementation.
I - IStudyPlanner has only the operations its clients use.
D - StudyPlannerService depends on interfaces (ICourse, IScheduling, IAIProvider, IStudyPlanRepository), not on concrete classes.
end note
@enduml
