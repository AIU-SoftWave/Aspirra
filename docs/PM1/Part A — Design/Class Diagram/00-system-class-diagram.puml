interface IAIProvider <<required - AI provider>> {
  +generate(prompt): AIResponse
}
interface IEmailGateway <<required - Email service>> {
  +send(to, subject, body): void
}
IStudentProfile <|.. StudentProfileService
IGoal <|.. GoalService
ICourse <|.. CourseService
IAssessment <|.. AssessmentService
IGoalPlanner <|.. GoalPlannerService
IStudyPlanner <|.. StudyPlannerService
IScheduling <|.. SchedulingService
IAdaptation <|.. AdaptationService
ICareer <|.. CareerService
ISkill <|.. SkillService
IPortfolio <|.. PortfolioService
IJobPrep <|.. JobPreparationService
IHabit <|.. HabitService
IAnalytics <|.. AnalyticsService
IPrediction <|.. PredictionService
ICoach <|.. AICoachService
IDashboard <|.. DashboardService
INotification <|.. NotificationService
IStudyGroup <|.. StudyGroupService
IAdministration <|.. AdministrationService
CourseService --> IAssessment
GoalPlannerService --> IGoal
GoalPlannerService --> IAIProvider
StudyPlannerService --> ICourse
StudyPlannerService --> IScheduling
StudyPlannerService --> IAIProvider
SchedulingService --> IGoalPlanner
SchedulingService --> IAssessment
SchedulingService --> IStudentProfile
AdaptationService --> IScheduling
CareerService --> IStudentProfile
CareerService --> IAIProvider
SkillService --> ICareer
PortfolioService --> ISkill
AnalyticsService --> IStudentProfile
AnalyticsService --> IScheduling
PredictionService --> IAnalytics
AICoachService --> IGoal
AICoachService --> IHabit
AICoachService --> IAnalytics
AICoachService --> IAIProvider
DashboardService --> IGoal
DashboardService --> IScheduling
DashboardService --> IAdaptation
DashboardService --> IHabit
DashboardService --> IAnalytics
DashboardService --> ICareer
NotificationService --> IAssessment
NotificationService --> IScheduling
NotificationService --> IHabit
NotificationService --> IPrediction
NotificationService --> IEmailGateway
StudyGroupService --> IStudentProfile
StudyGroupService --> IGoal
StudyGroupService --> IAnalytics
AdministrationService --> IStudentProfile
note as SOLID_NOTE
SOLID applied in every service:
S - one component class per service, helpers for single jobs.
O - behaviour extended through new implementations (AI model, widgets, channels, rules).
L - every component honours its provided interface.
I - small interfaces, one per service.
D - components depend only on interfaces; repositories, AI provider and email are abstractions.
end note
@enduml
