@startuml system-class-diagram
title Level 3: Code - System Class Diagram after SOLID (all services)
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam nodesep 35
skinparam ranksep 55
skinparam ArrowColor #444444
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  BackgroundColor<<component>> #D5EFE0
  BorderColor<<component>> #2E8B57
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
hide empty members

skinparam ranksep 80
skinparam nodesep 25
legend right
  |<#D5EFE0>   | Class of a component |
  |<#FFFFFF>   | Interface / domain class |
  | Solid arrow, open head | Uses (required interface / class) |
  | Dotted arrow, hollow head | Implements (provided interface) |
  | Filled diamond | Composition |
  | Plain line | Association |
endlegend

package "Ahmed Mohamed Ahmed" {
  interface IStudentProfile <<provided>>
  class StudentProfileService <<component>>
  interface IGoal <<provided>>
  class GoalService <<component>>
  interface ICourse <<provided>>
  class CourseService <<component>>
  interface IAssessment <<provided>>
  class AssessmentService <<component>>
}
