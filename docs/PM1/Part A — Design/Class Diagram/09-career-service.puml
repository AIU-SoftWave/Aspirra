@startuml career-service-class-diagram
title Level 3: Code - Class Diagram (career-service) - FR-09\nOwner: Arwa Mohey Hamdy
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam nodesep 35
skinparam ranksep 55
skinparam ArrowColor #444444
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  BackgroundColor<<component>> #D5EFE0
  BorderColor<<component>> #2E8B57
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
hide empty members

legend right
  |<#D5EFE0>   | Class of a component |
  |<#FFFFFF>   | Interface / domain class |
  | Solid arrow, open head | Uses (required interface / class) |
  | Dotted arrow, hollow head | Implements (provided interface) |
  | Filled diamond | Composition |
  | Plain line | Association |
endlegend

interface ICareer <<provided>> {
  +setTargetCareer(studentId, career): void
  +getRoadmap(studentId): Roadmap
  +completeMilestone(milestoneId): void
  +getProgress(studentId): int
  +getRequiredSkills(studentId): List<RequiredSkill>
}

class CareerService <<component>> {
  -studentProfile: IStudentProfile
  -aiProvider: IAIProvider
  -repository: IRoadmapRepository
  -roadmapPromptBuilder: RoadmapPromptBuilder
  --
  +setTargetCareer(...) / getRoadmap(...)
  +completeMilestone(...) / getProgress(...)
  +getRequiredSkills(...)
}

ICareer <|.. CareerService
class RoadmapPromptBuilder <<component>> {
  +build(career): String
}
CareerService --> RoadmapPromptBuilder

interface IStudentProfile <<required - Student service>> {
  +createProfile(studentId, data): Profile
  +updateProfile(studentId, data): Profile
  +getProfile(studentId): Profile
  +getAvailability(studentId): List<TimeSlot>
}

CareerService --> IStudentProfile
interface IAIProvider <<required - AI provider>> {
  +generate(prompt): AIResponse
}

CareerService --> IAIProvider
interface IRoadmapRepository <<required - Database>> {
  +save(item: Roadmap): void
  +findById(id): Roadmap
  +findByOwner(ownerId): List<Roadmap>
}

CareerService --> IRoadmapRepository
class Roadmap {
  -roadmapId: String
  -career: String
  -progress: int
  --
  +recalcProgress(): void
}
class RoadmapMilestone {
  -title: String
  -done: boolean
}
class RequiredSkill {
  -name: String
  -requiredLevel: int
}
IRoadmapRepository --> Roadmap
Roadmap *-- "1..*" RoadmapMilestone
Roadmap *-- "1..*" RequiredSkill
note bottom of CareerService
SOLID applied:
S - CareerService only coordinates; RoadmapPromptBuilder each do one job.
O - new behaviour is added by new implementations, not by editing CareerService.
L - CareerService can replace any other ICareer implementation.
I - ICareer has only the operations its clients use.
D - CareerService depends on interfaces (IStudentProfile, IAIProvider, IRoadmapRepository), not on concrete classes.
end note
@enduml
