@startuml Aspirra-Container-Diagram-Muhammed
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram - Owner: Muhammed Hany Hamdy (muhammedhanii)\nFR-17 Dashboard, FR-18 Notification, FR-19 Study Group, FR-20 Administration

Person(student, "Student", "Uses Aspirra")

System_Boundary(aspirra, "Aspirra System (Modular Monolith)") {
  Boundary(muhammed, "Owner: Muhammed Hany Hamdy") {
    Container(dashboardSvc, "Dashboard Service", "ASP.NET Core API", "FR-17 | Provides IDashboard\nAggregated dashboard")
    Container(notificationSvc, "Notification Service", "ASP.NET Core API", "FR-18 | Provides INotification\nNotifications across channels")
    Container(studyGroupSvc, "Study Group Service", "ASP.NET Core API", "FR-19 | Provides IStudyGroup\nStudy groups & accountability")
    Container(adminSvc, "Administration Service", "ASP.NET Core API", "FR-20 | Provides IAdministration\nSystem configuration")
  }
  
  Container(academicSvc, "Academic Service", "ASP.NET Core API", "FR-02 | IGoal")
  Container(studentSvc, "Student Service", "ASP.NET Core API", "FR-01 | IStudentProfile")
  Container(schedulingSvc, "Scheduling Service", "ASP.NET Core API", "FR-07 | IScheduling")
  Container(adaptationSvc, "Adaptation Service", "ASP.NET Core API", "FR-08 | IAdaptation")
  Container(habitSvc, "Habit Service", "ASP.NET Core API", "FR-13 | IHabit")
  Container(analyticsSvc, "Analytics Service", "ASP.NET Core API", "FR-14 | IAnalytics")
  Container(careerSvc, "Career Service", "ASP.NET Core API", "FR-09 | ICareer")
  Container(assessmentSvc, "Assessment Service", "ASP.NET Core API", "FR-04 | IAssessment")
  Container(predictionSvc, "Prediction Service", "ASP.NET Core API", "FR-15 | IPrediction")
}

System_Ext(aiProvider, "AI Provider", "External LLM API", "AI capabilities")
System_Ext(emailGateway, "Email Gateway", "External Email Service", "Email delivery")
ContainerDb(sharedDb, "Aspirra Database", "PostgreSQL / SQL Server", "Shared DB - each service owns schema/tables")

Rel(student, dashboardSvc, "Views", "IDashboard")
Rel(dashboardSvc, academicSvc, "Uses", "IGoal (required)")
Rel(dashboardSvc, schedulingSvc, "Uses", "IScheduling (required)")
Rel(dashboardSvc, adaptationSvc, "Uses", "IAdaptation (required)")
Rel(dashboardSvc, habitSvc, "Uses", "IHabit (required)")
Rel(dashboardSvc, analyticsSvc, "Uses", "IAnalytics (required)")
Rel(dashboardSvc, careerSvc, "Uses", "ICareer (required)")
Rel(notificationSvc, assessmentSvc, "Uses", "IAssessment (required)")
Rel(notificationSvc, schedulingSvc, "Uses", "IScheduling (required)")
Rel(notificationSvc, habitSvc, "Uses", "IHabit (required)")
Rel(notificationSvc, predictionSvc, "Uses", "IPrediction (required)")
Rel(notificationSvc, emailGateway, "Uses", "IEmailGateway (required)")
Rel(studyGroupSvc, studentSvc, "Uses", "IStudentProfile (required)")
Rel(studyGroupSvc, academicSvc, "Uses", "IGoal (required)")
Rel(studyGroupSvc, analyticsSvc, "Uses", "IAnalytics (required)")
Rel(adminSvc, studentSvc, "Uses", "IStudentProfile (required)")

Rel(dashboardSvc, sharedDb, "Reads/Writes (owns schema)", "SQL/ORM")
Rel(notificationSvc, sharedDb, "Reads/Writes (owns schema)", "SQL/ORM")
Rel(studyGroupSvc, sharedDb, "Reads/Writes (owns schema)", "SQL/ORM")
Rel(adminSvc, sharedDb, "Reads/Writes (owns schema)", "SQL/ORM")

SHOW_LEGEND()

@enduml
