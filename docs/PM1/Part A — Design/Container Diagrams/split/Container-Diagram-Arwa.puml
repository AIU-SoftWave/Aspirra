@startuml Container-Diagram-Arwa
left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 25
skinparam ranksep 65
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
  BackgroundColor<<dependency>> #F8FAFC
  BorderColor<<dependency>> #64748B
  BackgroundColor<<external>> #F1F5F9
  BorderColor<<external>> #475569
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 1: Container Diagram — Owner: Arwa Mohey Hamdy (ArwaMohey)\nFR-09 Career, FR-10 Skill, FR-11 Portfolio, FR-12 Job Preparation

actor "Student" as student

interface "ICareer" as ext_icareer
interface "ISkill" as ext_iskill
interface "IPortfolio" as ext_iportf
interface "IJobPrep" as ext_ijobprep

component "<<system>>\nAspirra (Modular Monolith)" as aspirra {
  portin " " as p_career
  portin " " as p_skill
  portin " " as p_portf
  portin " " as p_jobprep

  portout " " as p_ai
  portout " " as p_db_career
  portout " " as p_db_skill
  portout " " as p_db_portf
  portout " " as p_db_jobprep

  package "Owner: Arwa Mohey Hamdy" {
    component "Career Service\n(FR-09)" as careerSvc <<service>>
    component "Skill Service\n(FR-10)" as skillSvc <<service>>
    component "Portfolio Service\n(FR-11)" as portfolioSvc <<service>>
    component "Job Preparation Service\n(FR-12)" as jobPrepSvc <<service>>
  }

  package "Peer Services (Providers)" {
    component "Student Service\n(FR-01)" as studentSvc <<dependency>>
  }

  p_career -- careerSvc
  p_skill -- skillSvc
  p_portf -- portfolioSvc
  p_jobprep -- jobPrepSvc

  careerSvc -(0- studentSvc : IStudentProfile
  skillSvc -(0- careerSvc : ICareer
  portfolioSvc -(0- skillSvc : ISkill

  careerSvc -- p_ai

  careerSvc -- p_db_career
  skillSvc -- p_db_skill
  portfolioSvc -- p_db_portf
  jobPrepSvc -- p_db_jobprep
}

component "AI Provider\n(External LLM API)" as aiProvider <<external>>
database "Aspirra Database\n(PostgreSQL 16)\nSchemas: career, skill,\nportfolio, job_preparation" as sharedDb <<database>>

ext_icareer -- p_career
ext_iskill -- p_skill
ext_iportf -- p_portf
ext_ijobprep -- p_jobprep

student --( ext_icareer
student --( ext_iskill
student --( ext_iportf
student --( ext_ijobprep

p_ai -(0- aiProvider : IAIProvider
p_db_career -(0- sharedDb : ICareerDB
p_db_skill -(0- sharedDb : ISkillDB
p_db_portf -(0- sharedDb : IPortfolioDB
p_db_jobprep -(0- sharedDb : IJobPrepDB

legend bottom
  |= Symbol |= UML Meaning |
  | Square on boundary | Boundary port (portin / portout) |
  | Ball-and-socket -(0- | Assembly connector (requiring -> providing) |
  | <<service>> / <<dependency>> | Owned service / peer service provider |
endlegend
@enduml
