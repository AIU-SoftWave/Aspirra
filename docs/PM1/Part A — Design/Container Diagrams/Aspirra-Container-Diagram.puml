@startuml Aspirra-Container-Diagram
left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam nodesep 14
skinparam ranksep 65
skinparam port {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  BackgroundColor<<service>> #FFFFFF
  BorderColor<<service>> #2563EB
  BackgroundColor<<external>> #F1F5F9
  BorderColor<<external>> #475569
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #334155
}

title Level 1: Container Diagram - Aspirra (Student Success & Career Planner)

actor "Student" as student
actor "Administrator" as admin

' Provided interfaces exposed on the Aspirra system boundary
interface "IStudentProfile" as ext_istudent
interface "IGoal" as ext_igoal
interface "ICourse" as ext_icourse
interface "IAssessment" as ext_iassess
interface "IGoalPlanner" as ext_igplan
interface "IStudyPlanner" as ext_isplan
interface "IScheduling" as ext_isched
interface "IAdaptation" as ext_iadapt
interface "ICareer" as ext_icareer
interface "ISkill" as ext_iskill
interface "IPortfolio" as ext_iportf
interface "IJobPrep" as ext_ijobprep
interface "IHabit" as ext_ihabit
interface "IAnalytics" as ext_ianalytics
interface "IPrediction" as ext_ipred
interface "ICoach" as ext_icoach
interface "IDashboard" as ext_idash
interface "INotification" as ext_inotif
interface "IStudyGroup" as ext_igroup
interface "IAdministration" as ext_iadmin

component "<<system>>\nAspirra (Modular Monolith)" as aspirra {
  ' Provided boundary ports
  portin " " as p_student
  portin " " as p_goal
  portin " " as p_course
  portin " " as p_assess
  portin " " as p_gplan
  portin " " as p_splan
  portin " " as p_sched
  portin " " as p_adapt
  portin " " as p_career
  portin " " as p_skill
  portin " " as p_portf
  portin " " as p_jobprep
  portin " " as p_habit
  portin " " as p_analytics
  portin " " as p_pred
  portin " " as p_coach
  portin " " as p_dash
  portin " " as p_notif
  portin " " as p_group
  portin " " as p_admin

  ' Required external / persistence boundary ports
  portout " " as p_ai
  portout " " as p_email
  portout " " as p_db

  package "Owner: Ahmed Mohamed Ahmed" as g_ahmed {
    component "Student Service\n(FR-01)" as studentSvc <<service>>
    component "Academic Service\n(FR-02)" as academicSvc <<service>>
    component "Course Service\n(FR-03)" as courseSvc <<service>>
    component "Assessment Service\n(FR-04)" as assessmentSvc <<service>>
  }

  package "Owner: Yomna Mohamed Fekry" as g_yomna {
    component "Goal Planner Service\n(FR-05)" as goalPlannerSvc <<service>>
    component "Study Planner Service\n(FR-06)" as studyPlannerSvc <<service>>
    component "Scheduling Service\n(FR-07)" as schedulingSvc <<service>>
    component "Adaptation Service\n(FR-08)" as adaptationSvc <<service>>
  }

  package "Owner: Arwa Mohey Hamdy" as g_arwa {
    component "Career Service\n(FR-09)" as careerSvc <<service>>
    component "Skill Service\n(FR-10)" as skillSvc <<service>>
    component "Portfolio Service\n(FR-11)" as portfolioSvc <<service>>
    component "Job Preparation Service\n(FR-12)" as jobPrepSvc <<service>>
  }

  package "Owner: Mostafa Khamis Abozead" as g_mostafa {
    component "Habit Service\n(FR-13)" as habitSvc <<service>>
    component "Analytics Service\n(FR-14)" as analyticsSvc <<service>>
    component "Prediction Service\n(FR-15)" as predictionSvc <<service>>
    component "AI Coach Service\n(FR-16)" as aiCoachSvc <<service>>
  }

  package "Owner: Muhammed Hany Hamdy" as g_muhammed {
    component "Dashboard Service\n(FR-17)" as dashboardSvc <<service>>
    component "Notification Service\n(FR-18)" as notificationSvc <<service>>
    component "Study Group Service\n(FR-19)" as studyGroupSvc <<service>>
    component "Administration Service\n(FR-20)" as adminSvc <<service>>
  }

  ' Delegation from provided boundary ports to owning service containers
  p_student -- studentSvc
  p_goal -- academicSvc
  p_course -- courseSvc
  p_assess -- assessmentSvc
  p_gplan -- goalPlannerSvc
  p_splan -- studyPlannerSvc
  p_sched -- schedulingSvc
  p_adapt -- adaptationSvc
  p_career -- careerSvc
  p_skill -- skillSvc
  p_portf -- portfolioSvc
  p_jobprep -- jobPrepSvc
  p_habit -- habitSvc
  p_analytics -- analyticsSvc
  p_pred -- predictionSvc
  p_coach -- aiCoachSvc
  p_dash -- dashboardSvc
  p_notif -- notificationSvc
  p_group -- studyGroupSvc
  p_admin -- adminSvc

  ' Cross-service assembly connectors (socket on requiring service, lollipop on providing service)
  courseSvc -(0- assessmentSvc : IAssessment
  goalPlannerSvc -(0- academicSvc : IGoal
  studyPlannerSvc -(0- courseSvc : ICourse
  studyPlannerSvc -(0- schedulingSvc : IScheduling
  schedulingSvc -(0- goalPlannerSvc : IGoalPlanner
  schedulingSvc -(0- assessmentSvc : IAssessment
  schedulingSvc -(0- studentSvc : IStudentProfile
  adaptationSvc -(0- schedulingSvc : IScheduling
  careerSvc -(0- studentSvc : IStudentProfile
  skillSvc -(0- careerSvc : ICareer
  portfolioSvc -(0- skillSvc : ISkill
  analyticsSvc -(0- studentSvc : IStudentProfile
  analyticsSvc -(0- schedulingSvc : IScheduling
  predictionSvc -(0- analyticsSvc : IAnalytics
  aiCoachSvc -(0- academicSvc : IGoal
  aiCoachSvc -(0- habitSvc : IHabit
  aiCoachSvc -(0- analyticsSvc : IAnalytics
  dashboardSvc -(0- academicSvc : IGoal
  dashboardSvc -(0- schedulingSvc : IScheduling
  dashboardSvc -(0- adaptationSvc : IAdaptation
  dashboardSvc -(0- habitSvc : IHabit
  dashboardSvc -(0- analyticsSvc : IAnalytics
  dashboardSvc -(0- careerSvc : ICareer
  notificationSvc -(0- assessmentSvc : IAssessment
  notificationSvc -(0- schedulingSvc : IScheduling
  notificationSvc -(0- habitSvc : IHabit
  notificationSvc -(0- predictionSvc : IPrediction
  studyGroupSvc -(0- studentSvc : IStudentProfile
  studyGroupSvc -(0- academicSvc : IGoal
  studyGroupSvc -(0- analyticsSvc : IAnalytics
  adminSvc -(0- studentSvc : IStudentProfile

  ' Delegation from services to required external ports
  goalPlannerSvc -- p_ai
  studyPlannerSvc -- p_ai
  careerSvc -- p_ai
  aiCoachSvc -- p_ai
  notificationSvc -- p_email
  g_ahmed -- p_db
  g_yomna -- p_db
  g_arwa -- p_db
  g_mostafa -- p_db
  g_muhammed -- p_db
}

' External Systems & Shared Database
component "AI Provider\n(External LLM API)" as aiProvider <<external>>
component "Email Gateway\n(External Email Service)" as emailGateway <<external>>
database "Aspirra Database\n(PostgreSQL 16)\n20 isolated schemas\n(no cross-service DB reads)" as sharedDb <<database>>

' Wire provided lollipops to boundary ports
ext_istudent -- p_student
ext_igoal -- p_goal
ext_icourse -- p_course
ext_iassess -- p_assess
ext_igplan -- p_gplan
ext_isplan -- p_splan
ext_isched -- p_sched
ext_iadapt -- p_adapt
ext_icareer -- p_career
ext_iskill -- p_skill
ext_iportf -- p_portf
ext_ijobprep -- p_jobprep
ext_ihabit -- p_habit
ext_ianalytics -- p_analytics
ext_ipred -- p_pred
ext_icoach -- p_coach
ext_idash -- p_dash
ext_inotif -- p_notif
ext_igroup -- p_group
ext_iadmin -- p_admin

' Primary actor connections via required sockets
student --( ext_istudent
student --( ext_idash
admin --( ext_iadmin

' Required external & database assembly connectors
p_ai -(0- aiProvider : IAIProvider
p_email -(0- emailGateway : IEmailGateway
p_db -(0- sharedDb : IPersistence (per-service schemas)

legend bottom
  |= Symbol |= UML Meaning |
  | <<service>> component | ASP.NET Core service container (one per FR-01..FR-20) |
  | Square on boundary | Port (provided portin on left, required portout on right) |
  | Circle (lollipop) | Provided interface exposed by a service/system |
  | Half-circle (socket) | Required interface consumed by an actor or service |
  | Ball-and-socket -(0- | Assembly connector: requiring side (socket) -> providing side (lollipop) |
  | <<external>> / <<database>> | External third-party system / PostgreSQL 16 (isolated per-service schemas) |
endlegend
@enduml
