# Aspirra Environment Variables
ASPNETCORE_ENVIRONMENT=Development

# Shared PostgreSQL instance (each service owns its own schema)
POSTGRES_USER=aspirra_user
POSTGRES_PASSWORD=aspirra_password
POSTGRES_DB=aspirra

# External systems (used by later sprints)
AI_PROVIDER_API_KEY=your_ai_provider_key
EMAIL_GATEWAY_API_KEY=your_email_gateway_key
